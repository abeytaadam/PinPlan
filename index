MACHINES.sort((a, b) => a.sort.localeCompare(b.sort));
const byId = Object.fromEntries(MACHINES.map(m => [m.id, m]));

const GROUPS = [
  ["all", "All", () => true],
  ["stern", "Stern", m => m.group === "stern"],
  ["chicago", "Chicago Gaming", m => m.group === "chicago"],
  ["classic", "Classics", m => m.group === "classic"],
  ["spooky", "Spooky", m => m.group === "spooky"],
  ["notes", "Venue notes", m => m.venue.notes.length > 0]
];
const CAT = { multiball: "Multiball", skillshot: "Skill shot", secret: "Secret", general: "General", wizard: "Wizard" };

const esc = s => String(s).replace(/[&<>"]/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));
const shortScore = s => {
  const n = Number(s.replace(/,/g, ""));
  if (n >= 1e9) return (n / 1e9).toFixed(2) + "B";
  if (n >= 1e6) return Math.round(n / 1e6) + "M";
  return s;
};
const meta = m => [m.mfr, m.year, m.variant].filter(Boolean).join(" · ");

let state = { group: "all", q: "" };
try { const g = localStorage.getItem("sister-group"); if (g && GROUPS.some(x => x[0] === g)) state.group = g; } catch (e) {}

function renderTally() {
  const c = k => MACHINES.filter(GROUPS.find(g => g[0] === k)[2]).length;
  document.getElementById("tally").innerHTML =
    `<span><b>${MACHINES.length}</b> machines</span><span><b>${c("stern")}</b> Stern</span><span><b>${c("chicago")}</b> Chicago Gaming remakes</span><span><b>${c("classic")}</b> classics</span><span><b>${c("spooky")}</b> Spooky</span>`;
  document.getElementById("bar-count").textContent = MACHINES.length + " machines";
}

function renderChips() {
  const wrap = document.getElementById("chips");
  wrap.innerHTML = GROUPS.map(([k, label, fn]) =>
    `<button type="button" class="chip" id="chip-${k}" data-k="${k}" aria-pressed="${state.group === k}">${label}<span class="n">${MACHINES.filter(fn).length}</span></button>`
  ).join("");
  wrap.querySelectorAll(".chip").forEach(b => b.addEventListener("click", () => {
    state.group = b.dataset.k;
    try { localStorage.setItem("sister-group", state.group); } catch (e) {}
    wrap.querySelectorAll(".chip").forEach(x => x.setAttribute("aria-pressed", x.dataset.k === state.group));
    renderGrid();
  }));
}

function renderGrid() {
  const fn = GROUPS.find(g => g[0] === state.group)[2];
  const q = state.q.trim().toLowerCase();
  const list = MACHINES.filter(fn).filter(m => !q || (m.name + " " + m.code + " " + m.mfr).toLowerCase().includes(q));
  const grid = document.getElementById("grid");
  if (!list.length) {
    grid.innerHTML = `<div class="empty mono">No machines match “${esc(state.q)}”. Try a code like AFM or MM.</div>`;
    return;
  }
  grid.innerHTML = list.map(m => {
    const flags = [];
    if (m.venue.notes.length) flags.push(`<span class="flag warn"><span class="sq"></span>Venue note</span>`);
    if (m.venue.scores.length) flags.push(`<span class="flag">Top score ${shortScore(m.venue.scores[0][0])}</span>`);
    flags.push(`<span class="flag">${m.tips.length} PinTips</span>`);
    return `<a class="card" href="#${m.id}">
      <div class="card-top"><span class="code" aria-hidden="true">${m.code}</span><span class="mono dim">${m.year}</span></div>
      <h3>${esc(m.name)}</h3>
      <div class="meta mono">${esc([m.mfr, m.variant].filter(Boolean).join(" · "))}</div>
      <p class="line">${esc(m.thesis)}</p>
      <div class="flags">${flags.join("")}</div>
    </a>`;
  }).join("");
}

