        <span class="code" aria-hidden="true">${m.code}</span>
        <div><h2>${esc(m.name)}</h2><div class="mono dim">${esc(meta(m))} · At Sister now</div></div>
      </div>
    </header>
    <p class="thesis"><span class="tag">If you remember one thing</span>${esc(m.thesis)}</p>
    <div class="d-grid">
      <div class="col">
        <section class="sec primary">
          <div class="sec-h mono"><span>Tournament plan</span><span>In priority order</span></div>
          <div class="sec-b"><ol class="plan">${m.plan.map(p => `<li><span>${esc(p)}</span></li>`).join("")}</ol></div>
        </section>
        <section class="sec">
          <div class="sec-h mono"><span>Avoid</span><span class="dim">${m.avoid.length}</span></div>
          <div class="sec-b"><ul class="plain">${m.avoid.map(a => `<li><span>${esc(a)}</span></li>`).join("")}</ul></div>
        </section>
        <section class="sec">
          <div class="sec-h mono"><span>Rules in brief</span></div>
          <div class="sec-b"><p class="rules">${esc(m.rules)}</p></div>
        </section>
      </div>
      <div class="col">
        <section class="sec">
          <div class="sec-h mono"><span>At Sister</span><span class="dim">Pinball Map</span></div>
          <div class="sec-b">${notes}${copy}${scores}</div>
        </section>
        <section class="sec">
          <div class="sec-h mono"><span>PinTips</span><span class="dim">Top voted, summarized</span></div>
          <div class="sec-b"><ul class="tips">${tips}</ul></div>
        </section>
        <section class="sec">
          <div class="sec-h mono"><span>Sources</span></div>
          <div class="sec-b"><ul class="srcs">${srcs}</ul></div>
        </section>
      </div>
    </div>
    <nav class="pager" aria-label="Previous and next machine">
      <a href="#${prev.id}"><span class="mono dim">← Previous</span><span class="nm">${esc(prev.name)}</span></a>
      <a href="#${next.id}"><span class="mono dim">Next →</span><span class="nm">${esc(next.name)}</span></a>
    </nav>`;
}

let homeScroll = 0;
function route() {
  const id = decodeURIComponent(location.hash.slice(1));
  const m = byId[id];
  const home = document.getElementById("home"), detail = document.getElementById("detail");
  if (m) {
    if (!home.hidden) homeScroll = window.scrollY;
    renderDetail(m);
    home.hidden = true; detail.hidden = false;
    window.scrollTo(0, 0);
  } else {
    detail.hidden = true; home.hidden = false;
    window.scrollTo(0, homeScroll);
  }
}

/* ---------- DMD ---------- */
(function dmd() {
  const cv = document.getElementById("dmd");
  const ctx = cv.getContext("2d");
  const COLS = 128, ROWS = 32;
  const off = document.createElement("canvas");
  off.width = COLS; off.height = ROWS;
  const octx = off.getContext("2d", { willReadFrequently: true });
  const MSG = "SISTER · 16 PINS · PLAN FIRST · ";
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  let x = 0, textW = 0, raf = 0, last = 0, visible = true;
  const css = getComputedStyle(document.documentElement);
  const ON = css.getPropertyValue("--dmd").trim() || "#ff6b1f";
  const OFF = css.getPropertyValue("--dmd-off").trim() || "#24150e";

  function size() {
    const r = cv.getBoundingClientRect();
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    cv.width = Math.max(256, Math.round(r.width * dpr));
    cv.height = Math.round(cv.width / 4);
  }
  function setFont() {
    octx.font = "600 23px 'IBM Plex Mono', ui-monospace, monospace";
    octx.textBaseline = "middle";
    textW = octx.measureText(MSG).width;
  }
  function frame(staticWord) {
    octx.clearRect(0, 0, COLS, ROWS);
    octx.fillStyle = "#fff";
    if (staticWord) {
      octx.textAlign = "center";
      octx.fillText("SISTER", COLS / 2, ROWS / 2 + 1);
    } else {
      octx.textAlign = "left";
      octx.fillText(MSG, -x, ROWS / 2 + 1);
      octx.fillText(MSG, -x + textW, ROWS / 2 + 1);
    }
    const data = octx.getImageData(0, 0, COLS, ROWS).data;
    const cw = cv.width / COLS, rad = cw * 0.36;
    ctx.fillStyle = "#050506";
    ctx.fillRect(0, 0, cv.width, cv.height);
    for (let r = 0; r < ROWS; r++) {
      for (let c = 0; c < COLS; c++) {
        const lit = data[(r * COLS + c) * 4 + 3] > 110;
        ctx.fillStyle = lit ? ON : OFF;
        ctx.beginPath();
        ctx.arc(c * cw + cw / 2, r * cw + cw / 2, rad, 0, Math.PI * 2);
        ctx.fill();
      }
    }
  }
  function loop(t) {
    raf = requestAnimationFrame(loop);
    if (!visible || t - last < 55) return;
    last = t;
    x = (x + 1) % Math.max(1, Math.round(textW));
    frame(false);
  }
  function start() {
    size(); setFont();
    if (reduce) { frame(true); return; }
    frame(false);
    cancelAnimationFrame(raf);
    raf = requestAnimationFrame(loop);
  }
  start();
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(start);
  window.addEventListener("resize", () => { size(); frame(reduce); });
  if ("IntersectionObserver" in window) {
    new IntersectionObserver(es => { visible = es[0].isIntersecting; }).observe(cv);
  }
})();

document.getElementById("q").addEventListener("input", e => { state.q = e.target.value; renderGrid(); });
window.addEventListener("hashchange", route);
renderTally(); renderChips(); renderGrid(); route();
